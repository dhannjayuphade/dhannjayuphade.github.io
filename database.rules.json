{
  "rules": {
    "admins": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": false
    },
    "users": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['email'])",
        "uid":           { ".validate": "newData.isString() && newData.val() === $uid" },
        "name":          { ".validate": "newData.isString() && newData.val().length <= 80" },
        "email":         { ".validate": "newData.isString() && newData.val().length <= 200" },
        "phone":         { ".validate": "newData.isString() && newData.val().length <= 20" },
        "city":          { ".validate": "newData.isString() && newData.val().length <= 80" },
        "bio":           { ".validate": "newData.isString() && newData.val().length <= 300" },
        "photo":         { ".validate": "newData.isString() && newData.val().length <= 150000" },
        "provider":      { ".validate": "newData.isString() && newData.val().length <= 40" },
        "emailVerified": { ".validate": "newData.isBoolean()" },
        "createdAt":     { ".validate": "newData.isNumber()" },
        "lastLogin":     { ".validate": "newData.isNumber()" },
        "loginCount":    { ".validate": "newData.isNumber()" },
        "recent": {
          "$i": { ".validate": "newData.isNumber()" }
        },
        "devices": {
          "$deviceId": {
            ".validate": "newData.hasChildren(['lastSeen'])",
            "label":    { ".validate": "newData.isString() && newData.val().length <= 100" },
            "lastSeen": { ".validate": "newData.isNumber()" },
            "$other":   { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    },
    "$other": { ".read": false, ".write": false }
  }
      }
